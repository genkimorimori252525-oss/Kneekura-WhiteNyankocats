package __KNEEKURA_PACKAGE__;

import android.opengl.GLSurfaceView;
import android.os.FileObserver;

import java.io.File;
import java.io.IOException;
import java.lang.reflect.Constructor;
import java.lang.reflect.Field;
import java.net.URL;
import java.nio.ByteBuffer;
import java.util.HashMap;
import java.util.Map;

/**
 * Exact JP 15.7.1 preservation-first HTTP bridge.
 *
 * This class deliberately subclasses the original Battle Cats MyActivity.
 * All original UI/lifecycle behavior is inherited unchanged. Only the observed
 * backup-service request family can be locally replayed, and only when the
 * build-time feature gate is enabled. Every other request calls super exactly.
 */
public final class MyActivity extends jp.co.ponos.battlecats.MyActivity {
    private static final boolean PC_JNI_SCENE_OBSERVER = __KNEEKURA_PC_JNI_SCENE_OBSERVER__;
    private static native boolean kneekuraAttachPcSceneObserver(Class<?> originalClass);

    // PC_OBSERVER_BEGIN
    @Override
    protected void onCreate(android.os.Bundle state) {
        super.onCreate(state);
        if (!PC_JNI_SCENE_OBSERVER) {
            return;
        }
        try {
            // Original class initialization/loading is complete before here.
            // Explicit load binds this class loader to the already mapped shim.
            System.loadLibrary("kneekura");
            Field field = jp.co.ponos.battlecats.MyActivity.class.getDeclaredField("mGLView");
            field.setAccessible(true);
            GLSurfaceView view = (GLSurfaceView) field.get(this);
            if (view == null) {
                throw new IllegalStateException("original GL view unavailable");
            }
            view.queueEvent(new Runnable() {
                @Override
                public void run() {
                    try {
                        if (!kneekuraAttachPcSceneObserver(jp.co.ponos.battlecats.MyActivity.class)) {
                            debugResearch("original-native-pc-jni-scene-v1 unavailable");
                        }
                    } catch (LinkageError | RuntimeException failure) {
                        debugResearch("original-native-pc-jni-scene-v1 unavailable");
                    }
                }
            });
        } catch (ReflectiveOperationException | LinkageError | RuntimeException failure) {
            debugResearch("original-native-pc-jni-scene-v1 unavailable");
        }
    }

    // PC_OBSERVER_END
    private static final boolean ENABLE_BACKUP_OFFLINE_REPLAY = __KNEEKURA_ENABLE_BACKUP_REPLAY__;
    private static final boolean DEBUG_RESEARCH_LOG = __KNEEKURA_DEBUG_LOG__;
    private static final boolean USE_EXTERNAL_FILES_DIR = __KNEEKURA_USE_EXTERNAL_FILES_DIR__;
    // Research-only: redirect ORIGINAL native getFilesDir() consumers to a
    // fresh, app-private versioned root. This is not an independent SAVE schema
    // or proof that original game boot/level-up works without remote services.
    private static final boolean ISOLATE_ORIGINAL_NATIVE_FILES_DIR =
            __KNEEKURA_ISOLATE_ORIGINAL_NATIVE_FILES_DIR__;
    private static final String ORIGINAL_NATIVE_FILES_LEAF = "kneekura-native-jp15-7-1";
    // A DIFFERENT Android package has its own internal files directory.
    // This exact-version local-research flavor is intentionally distinct
    // from both PONOS and older jp.kn.trace.battlecats installations.
    // It keeps the ORIGINAL native file root (no child redirection) to avoid
    // hiding the game's non-SAVE_DATA assets. This gate is NOT a new save
    // schema and does NOT yet certify original-game first-run compatibility.
    private static final boolean LOCAL_RESEARCH_FRESH_ROOT =
            __KNEEKURA_LOCAL_RESEARCH_FRESH_ROOT__;
    private static final boolean LOCAL_RESEARCH_DENY_HTTP =
            __KNEEKURA_LOCAL_RESEARCH_DENY_HTTP__;
    private static final boolean LOCAL_RESEARCH_IMPORT_OWNER_ASSETS =
            __KNEEKURA_OFFLINE_IMPORT_ENABLED__;
    // Extra explicit opt-in, absent from default and passive research builds.
    private static final boolean RESEARCH_VIRGIN_SAVE_TRIAL =
            __KNEEKURA_RESEARCH_VIRGIN_SAVE_TRIAL__;
    private static native boolean kneekuraAttestVirginRoot(String canonicalRoot);
    private static boolean virginMarkerCreatedInThisProcess;
    private static boolean virginNativeRootAttested;
    private static final String LOCAL_RESEARCH_MARKER = ".kneekura-virgin-local-jp15-7-1";
    private static final String[] FORBIDDEN_PREEXISTING_SAVES = {
            "SAVE_DATA", "SAVE_DATA4", "SAVE_DATA8"
    };


    // Debug-only metadata: no SAVE_DATA bytes or account identifiers are read.
    // Used solely to witness whether the ORIGINAL native host created a new
    // local SAVE file between getFilesDir calls/restarts.
    private static volatile String lastLocalSavePresence;
    // Only local-research: retain a FileObserver so changes made by the
    // ORIGINAL native writer can be noticed after getFilesDir has returned.
    // Initial snapshots alone cannot observe a late SAVE_DATA creation.
    private static volatile FileObserver originalLocalSaveObserver;
    private static volatile String originalLocalSaveObserverRoot;

    private static final String BACKUP_SCHEME = "https";
    private static final String BACKUP_HOST = "nyanko-backups.ponosgames.com";
    private static final String BACKUP_PATH = "/";

    private static volatile ReflectionCache reflectionCache;

    // PC_BOOT_BEGIN
    @Override public void setWebViewUrl(final int handle, final String url, final String[] cookies) {
        if (!KneekuraPcAgeAssets.isPage(url)) {
            super.setWebViewUrl(handle, url, cookies);
            return;
        }
        // Ordered after the original newWebView runnable, before its loadUrl.
        runOnUiThread(new Runnable() {
            @Override public void run() {
                try {
                    KneekuraPcAgeWebView.install(MyActivity.this, handle, getFilesDir());
                    MyActivity.super.setWebViewUrl(handle, url, cookies);
                    debugResearch("original-local-pc-age-page-v1 ready");
                } catch (ReflectiveOperationException | RuntimeException ignored) {
                    debugResearch("original-local-pc-age-page-v1 unavailable");
                }
            }
        });
    }
    // PC_BOOT_END

    private static final class ReflectionCache {
        final Field nextRequestHandle;
        final Field requestHandles;
        final Field glView;
        final Constructor<?> requestConstructor;

        ReflectionCache() throws Exception {
            Class<?> base = jp.co.ponos.battlecats.MyActivity.class;

            nextRequestHandle = base.getDeclaredField("mNextRequestHandle");
            nextRequestHandle.setAccessible(true);

            requestHandles = base.getDeclaredField("mRequestHandles");
            requestHandles.setAccessible(true);

            glView = base.getDeclaredField("mGLView");
            glView.setAccessible(true);

            Class<?> requestClass = Class.forName("a32");
            requestConstructor = requestClass.getDeclaredConstructor(
                    int.class,
                    String.class,
                    URL.class,
                    float.class,
                    HashMap.class,
                    ByteBuffer.class,
                    String[].class
            );
            requestConstructor.setAccessible(true);
        }
    }

    private static void debugResearch(String message) {
        if (DEBUG_RESEARCH_LOG) {
            android.util.Log.i("KNEEKURA_STATIC_HTTP", message);
        }
    }

    /**
     * Existing JP15.7.1 native code references Activity.getFilesDir().
     * Only research builds explicitly requesting the local-source seam use
     * this isolated folder. Fail CLOSED instead of falling back to the
     * original PONOS file root if this folder is unavailable/unsafe.
     *
     * IMPORTANT: the original native app may expect additional local assets
     * under getFilesDir. This method alone neither seeds a fresh gameplay
     * state nor implements a network-free game or independent player authority.
     */
    private static void probeLocalGameSaveFiles(File root) {
        if (!LOCAL_RESEARCH_FRESH_ROOT || !DEBUG_RESEARCH_LOG) {
            return;
        }
        // File metadata only. No original save content, inquiry code, token,
        // resource/account data or absolute filesystem path is recorded.
        StringBuilder status = new StringBuilder("original-save-presence-v1");
        try {
            String trusted = root.getCanonicalPath() + File.separator;
            for (String filename : FORBIDDEN_PREEXISTING_SAVES) {
                File candidate = new File(root, filename);
                if (!candidate.getCanonicalPath().startsWith(trusted)) {
                    status.append(" ").append(filename).append("=unsafe");
                } else if (candidate.isFile()) {
                    status.append(" ").append(filename).append("=present:");
                    status.append(candidate.length());
                } else {
                    status.append(" ").append(filename).append("=absent");
                }
            }
        } catch (IOException error) {
            // Never inspect or export a path if canonical containment failed.
            status = new StringBuilder("original-save-presence-v1 unavailable");
        }
        String snapshot = status.toString();
        synchronized (MyActivity.class) {
            if (!snapshot.equals(lastLocalSavePresence)) {
                lastLocalSavePresence = snapshot;
                debugResearch(snapshot);
            }
        }
    }

    // Once per process: metadata-only diagnosis of the ORIGINAL native
    // DownloadBatchTask's 35 "download_%d.tsv" candidates. The native
    // 0x320be0 resolver also checks its own source index; a bare file here
    // is NOT proof the original engine accepts or even requests it.
    private static boolean localDownloadTsvProbeCompleted;

    private static void probeLocalDownloadBatchTsvFiles(File root) {
        if (!LOCAL_RESEARCH_FRESH_ROOT || !DEBUG_RESEARCH_LOG) {
            return;
        }
        synchronized (MyActivity.class) {
            if (localDownloadTsvProbeCompleted) {
                return;
            }
            int present = 0;
            int absent = 0;
            int unsafe = 0;
            try {
                String trusted = root.getCanonicalPath() + File.separator;
                for (int index = 0; index < 35; index++) {
                    File candidate = new File(root, "download_" + index + ".tsv");
                    if (!candidate.getCanonicalPath().startsWith(trusted)) {
                        unsafe++;
                    } else if (candidate.isFile()) {
                        present++;
                    } else {
                        absent++;
                    }
                }
                debugResearch("original-download-tsv-loose-v1 present=" + present
                        + " absent=" + absent + " unsafe=" + unsafe);
            } catch (IOException error) {
                debugResearch("original-download-tsv-loose-v1 unavailable");
            }
            // Logging source-file presence once on first getFilesDir() keeps
            // the original frame/render loop free of repeated disk scans.
            localDownloadTsvProbeCompleted = true;
        }
    }


    private static void watchOriginalLocalSaveChanges(final File root) {
        if (!LOCAL_RESEARCH_FRESH_ROOT || !DEBUG_RESEARCH_LOG) {
            return;
        }
        synchronized (MyActivity.class) {
            try {
                final String canonicalRoot = root.getCanonicalPath();
                if (originalLocalSaveObserver != null) {
                    if (!canonicalRoot.equals(originalLocalSaveObserverRoot)) {
                        throw new IllegalStateException(
                                "research original files root changed during observation");
                    }
                    return;
                }
                FileObserver watcher = new FileObserver(
                        canonicalRoot,
                        FileObserver.CREATE | FileObserver.CLOSE_WRITE
                                | FileObserver.MOVED_TO | FileObserver.DELETE
                ) {
                    @Override
                    public void onEvent(int event, String filename) {
                        if (filename == null || filename.contains("/")
                                || filename.contains("\\")) {
                            return;
                        }
                        boolean tracked = false;
                        for (String known : FORBIDDEN_PREEXISTING_SAVES) {
                            if (known.equals(filename)) {
                                tracked = true;
                                break;
                            }
                        }
                        if (tracked) {
                            // Re-use the existing metadata-only canonical
                            // containment probe. Never inspect SAVE contents.
                            probeLocalGameSaveFiles(root);
                        }
                    }
                };
                watcher.startWatching();
                originalLocalSaveObserver = watcher;
                originalLocalSaveObserverRoot = canonicalRoot;
                debugResearch("original-save-event-observer-v1 active");
            } catch (IOException | SecurityException error) {
                // Research diagnostics must not corrupt the native game's
                // SAVE or convert an unavailable watcher into a fake PASS.
                debugResearch("original-save-event-observer-v1 unavailable");
            }
        }
    }

    // Dedicated original-research-only OS file-event witness. It observes
    // access events to the isolated research app's owned root, and emits ONLY
    // bounded filename CLASSES once per process. It never opens or reads any
    // asset, SAVE, URL, account data or shared publisher app folder.
    private static volatile FileObserver originalAssetAccessObserver;
    private static volatile String originalAssetAccessObserverRoot;
    private static final java.util.concurrent.atomic.AtomicInteger
            originalAssetAccessKindsSeen = new java.util.concurrent.atomic.AtomicInteger(0);

    private static void observeOriginalAssetFileAccess(File root) {
        if (!LOCAL_RESEARCH_FRESH_ROOT || !LOCAL_RESEARCH_IMPORT_OWNER_ASSETS
                || !DEBUG_RESEARCH_LOG) {
            return;
        }
        synchronized (MyActivity.class) {
            try {
                final String canonical = root.getCanonicalPath();
                if (originalAssetAccessObserver != null
                        && canonical.equals(originalAssetAccessObserverRoot)) {
                    return;
                }
                FileObserver watcher = new FileObserver(
                        canonical, FileObserver.OPEN | FileObserver.ACCESS) {
                    @Override
                    public void onEvent(int event, String filename) {
                        if (filename == null || filename.contains("/")
                                || filename.contains("\\")
                                || (event & (FileObserver.OPEN | FileObserver.ACCESS)) == 0) {
                            return;
                        }
                        int bit = 0;
                        String kind = null;
                        if (filename.matches(
                                "download_(?:[0-9]|[12][0-9]|3[0-4])\\.tsv")) {
                            bit = 1;
                            kind = "download-tsv";
                        } else if (filename.matches(
                                "[A-Za-z][A-Za-z0-9_]*Server\\.list")) {
                            bit = 2;
                            kind = "server-list";
                        } else if (filename.matches(
                                "[A-Za-z][A-Za-z0-9_]*Server\\.pack")) {
                            bit = 4;
                            kind = "server-pack";
                        } else if (filename.matches("[A-Za-z0-9_-]+\\.(ogg|caf)")) {
                            bit = 8;
                            kind = "media";
                        }
                        if (bit != 0) {
                            final int matchedBit = bit;
                            int previous = originalAssetAccessKindsSeen.getAndUpdate(
                                    value -> value | matchedBit);
                            if ((previous & matchedBit) == 0) {
                                debugResearch("original-local-file-access-v1 " + kind);
                            }
                        }
                    }
                };
                watcher.startWatching();
                originalAssetAccessObserver = watcher;
                originalAssetAccessObserverRoot = canonical;
                debugResearch("original-local-file-access-v1 watching");
            } catch (IOException | SecurityException unavailable) {
                debugResearch("original-local-file-access-v1 unavailable");
            }
        }
    }

    private File newLocalOriginalGameRoot() {
        // The local-research PACKAGE ALREADY has its own Android app-data root.
        // Its first observed use must not silently reuse a previous experiment's
        // SAVE_DATA. The marker records local-origin only; it is NOT an account,
        // a game-save serializer, an authentication secret, or a format upgrade.
        if (USE_EXTERNAL_FILES_DIR || ISOLATE_ORIGINAL_NATIVE_FILES_DIR) {
            throw new IllegalStateException("conflicting original local research file modes");
        }
        synchronized (MyActivity.class) {
            File root = super.getFilesDir();
            if (root == null || !root.isDirectory()) {
                throw new IllegalStateException("original local research private files unavailable");
            }
            File marker = new File(root, LOCAL_RESEARCH_MARKER);
            try {
                String exactMarkerPath = new File(
                        root.getCanonicalPath(), LOCAL_RESEARCH_MARKER
                ).getPath();
                if (marker.exists()) {
                    // Reject a symlink or replacement marker with foreign content.
                    if (!marker.getCanonicalPath().equals(exactMarkerPath)
                            || !marker.isFile() || marker.length() != 0L) {
                        throw new IllegalStateException("untrusted local research origin marker");
                    }
                } else {
                    for (String filename : FORBIDDEN_PREEXISTING_SAVES) {
                        if (new File(root, filename).exists()) {
                            throw new IllegalStateException("unowned prior SAVE_DATA in local research package");
                        }
                    }
                    if (!marker.createNewFile()) {
                        throw new IllegalStateException("local research origin marker creation failed");
                    }
                    // A marker from an earlier process must NEVER authorize
                    // first-SAVE creation, even if the expected files are absent.
                    virginMarkerCreatedInThisProcess = true;
                }
                // Canonical path check AFTER creation catches symlink relocation.
                if (!marker.getCanonicalPath().equals(exactMarkerPath)
                        || !marker.isFile() || marker.length() != 0L) {
                    throw new IllegalStateException("local research origin marker changed");
                }
            } catch (IOException error) {
                throw new IllegalStateException("original local research origin root unavailable", error);
            }
            if (RESEARCH_VIRGIN_SAVE_TRIAL
                    && virginMarkerCreatedInThisProcess
                    && !virginNativeRootAttested) {
                // The native side also verifies the exact original source,
                // hooks, no prior SAVE files, root UID and empty marker.
                try {
                    System.loadLibrary("kneekura");
                    if (kneekuraAttestVirginRoot(root.getCanonicalPath())) {
                        virginNativeRootAttested = true;
                        debugResearch("original-virgin-root-attested-v1");
                    }
                } catch (UnsatisfiedLinkError | IOException unavailable) {
                    // Original ELF hooks can be absent this early in startup.
                    // No writer is authorized until native attestation succeeds.
                    debugResearch("original-virgin-root-not-ready-v1");
                }
            }
            probeLocalGameSaveFiles(root);
            watchOriginalLocalSaveChanges(root);
            probeLocalDownloadBatchTsvFiles(root);
            observeOriginalAssetFileAccess(root);
            // Research-only, feature OFF by default. The importer works only
            // from THIS isolated package's ADB-staged external files root,
            // verifying all source-pinned game assets before any internal copy.
            // Never block the native JNI/render thread on 668 MB of I/O.
            if (LOCAL_RESEARCH_IMPORT_OWNER_ASSETS) {
                try {
                    // Original Activity compiles independently in research
                    // fixture runners. Reflective opt-in is enabled only in
                    // exact owner asset importer builds, where the secondary
                    // Java class is compiled into the same classes5.dex.
                    Class<?> importer = Class.forName(
                            "__KNEEKURA_PACKAGE__.KneekuraOfflineAssetImporter");
                    java.lang.reflect.Method schedule = importer.getDeclaredMethod(
                            "schedule", MyActivity.class, File.class);
                    schedule.setAccessible(true);
                    schedule.invoke(null, this, root);
                } catch (Exception unavailable) {
                    debugResearch("original-local-import-v1 unavailable");
                }
            }
            debugResearch("original-local-fresh-package-root active");
            return root;
        }
    }

    @Override
    public File getFilesDir() {
        if (LOCAL_RESEARCH_FRESH_ROOT) {
            return newLocalOriginalGameRoot();
        }
        if (ISOLATE_ORIGINAL_NATIVE_FILES_DIR) {
            if (USE_EXTERNAL_FILES_DIR) {
                throw new IllegalStateException("conflicting original save directory modes");
            }
            // Never cache an unchecked path: a later symlink replacement must
            // not escape the original app-private storage boundary.
            File base = super.getFilesDir();
            if (base == null || !base.isDirectory()) {
                throw new IllegalStateException("original app-private files directory unavailable");
            }
            File directory = new File(base, ORIGINAL_NATIVE_FILES_LEAF);
            try {
                String trusted = base.getCanonicalPath() + File.separator;
                if (!directory.getCanonicalPath().startsWith(trusted)) {
                    throw new IllegalStateException("original native private save root escaped");
                }
                if (!directory.isDirectory() && (!directory.mkdirs() || !directory.isDirectory())) {
                    throw new IllegalStateException("original native private save root unavailable");
                }
                if (!directory.getCanonicalPath().startsWith(trusted)) {
                    throw new IllegalStateException("original native private save root changed during creation");
                }
            } catch (IOException error) {
                throw new IllegalStateException("original native private save root unresolved", error);
            }
            debugResearch("original-native-private-files-root active");
            return directory;
        }
        if (!USE_EXTERNAL_FILES_DIR) {
            return super.getFilesDir();
        }
        File external = super.getExternalFilesDir(null);
        if (external == null) {
            return super.getFilesDir();
        }
        if (!external.exists()) {
            external.mkdirs();
        }
        debugResearch("external-files-dir active");
        return external;
    }

    private static ReflectionCache reflectionCache() throws Exception {
        ReflectionCache cache = reflectionCache;
        if (cache != null) {
            return cache;
        }
        synchronized (MyActivity.class) {
            cache = reflectionCache;
            if (cache == null) {
                cache = new ReflectionCache();
                reflectionCache = cache;
            }
            return cache;
        }
    }

    private static boolean isExactBackupRequest(
            String method,
            String requestUrl,
            float timeout,
            HashMap<?, ?> headers,
            ByteBuffer body,
            String[] strings,
            boolean flag1,
            boolean flag2) {
        // The strict offline original-game research profile may reproduce
        // ONLY the exact original backup request *identity* and documented
        // original OFFLINE failure response. The isolated device has also shown
        // an otherwise-identical timeout variant (mask 0x7fd). Transport-only
        // timeout tolerance is isolated to research; shipping modes never do.
        if (!ENABLE_BACKUP_OFFLINE_REPLAY
                && !(LOCAL_RESEARCH_DENY_HTTP && LOCAL_RESEARCH_IMPORT_OWNER_ASSETS)) {
            return false;
        }
        // The original OWNER device emitted backup-shape mask 0x7fd during
        // scene97: all URI, method, payload and flag invariants matched, but
        // timeout != 10. In the isolated no-INTERNET research profile ONLY,
        // timeout is transport policy, not backup identity. As a bounded
        // RESEARCH HYPOTHESIS only, queue the same source-observed ORIGINAL
        // failure callback for positive finite timeout variants through 120s.
        // This may or may not resolve scene97; do not claim source parity.
        // Personal/practice/replay profiles retain the EXACT timeout=10 gate.
        final boolean isolatedOfflineResearch =
                LOCAL_RESEARCH_DENY_HTTP && LOCAL_RESEARCH_IMPORT_OWNER_ASSETS;
        if (!"GET".equals(method)
                || (!isolatedOfflineResearch && Float.compare(timeout, 10.0f) != 0)
                || (isolatedOfflineResearch && (!Float.isFinite(timeout)
                        || timeout <= 0.0f || timeout > 120.0f))) {
            return false;
        }
        if (headers == null || !headers.isEmpty() || body != null) {
            return false;
        }
        if (strings == null || strings.length != 0 || flag1 || flag2) {
            return false;
        }

        try {
            URL parsed = new URL(requestUrl);
            return BACKUP_SCHEME.equals(parsed.getProtocol())
                    && BACKUP_HOST.equals(parsed.getHost())
                    && BACKUP_PATH.equals(parsed.getPath())
                    && parsed.getQuery() != null
                    && parsed.getPort() == -1
                    && parsed.getUserInfo() == null
                    && parsed.getRef() == null;
        } catch (Exception ignored) {
            return false;
        }
    }

    // Only in the explicit 393-original-data OFFLINE research profile:
    // classify a blocked request as a tiny fixed category, NOT a raw URL.
    // No network I/O, credentials, hostnames, paths, method or headers in log.
    private static String classifyDeniedOriginalHttp(String requestUrl) {
        if (requestUrl == null || requestUrl.length() > 4096) {
            return "malformed";
        }
        try {
            java.net.URI uri = new java.net.URI(requestUrl);
            String scheme = uri.getScheme();
            String host = uri.getHost();
            if (scheme == null || !"https".equalsIgnoreCase(scheme)
                    || host == null || uri.getUserInfo() != null) {
                return "malformed";
            }
            String lowered = host.toLowerCase(java.util.Locale.ROOT);
            if ("nyanko-assets.ponosgames.com".equals(lowered)) {
                return "asset-cdn";
            }
            if ("nyanko-backups.ponosgames.com".equals(lowered)) {
                return "backup";
            }
            if ("ponosgames.com".equals(lowered)
                    || lowered.endsWith(".ponosgames.com")) {
                return "publisher-other";
            }
            return "external-other";
        } catch (java.net.URISyntaxException invalid) {
            return "malformed";
        }
    }

    /**
     * Source-proof-only shape witness for a blocked BACKUP HOST request.
     * Each bit means the non-sensitive property of the already observed JP
     * offline backup GET matches. No URL, query, credential, body, header,
     * method value or response data is ever serialized to logcat.
     * A mismatched shape is blocked unless the isolated research-only
     * bounded timeout A/B is active and the strict URL envelope matches.
     * The URI bitmask alone never establishes acceptance.
     */
    private static int originalBackupShapeMask(
            String method, String requestUrl, float timeout, HashMap headers,
            ByteBuffer body, String[] strings, boolean flag1, boolean flag2) {
        int bits = 0;
        if ("GET".equals(method)) bits |= 1;
        if (Float.compare(timeout, 10.0f) == 0) bits |= 2;
        if (headers != null && headers.isEmpty()) bits |= 4;
        if (body == null) bits |= 8;
        if (strings != null && strings.length == 0) bits |= 16;
        if (!flag1) bits |= 32;
        if (!flag2) bits |= 64;
        if (requestUrl == null || requestUrl.length() > 4096) return bits;
        try {
            java.net.URI uri = new java.net.URI(requestUrl);
            if (!"nyanko-backups.ponosgames.com".equalsIgnoreCase(
                    uri.getHost())) return bits;
            if ("https".equalsIgnoreCase(uri.getScheme())) bits |= 128;
            if ("/".equals(uri.getRawPath())) bits |= 256;
            if (uri.getRawQuery() != null) bits |= 512;
            if (uri.getPort() == -1 && uri.getRawUserInfo() == null
                    && uri.getRawFragment() == null) bits |= 1024;
        } catch (java.net.URISyntaxException ignored) {
            // Treat malformed raw request as unmatched, never print it.
        }
        return bits;
    }

    // Safe bounded metadata only, recorded for blocked backup-shaped
    // requests. No raw float/URL/query/token/header/body is ever written.
    private static String originalBackupTimeoutClass(float timeout) {
        if (!Float.isFinite(timeout)) return "nonfinite";
        if (timeout <= 0.0f) return "nonpositive";
        if (timeout < 10.0f) return "lt10";
        if (Float.compare(timeout, 10.0f) == 0) return "eq10";
        if (timeout <= 30.0f) return "gt10-le30";
        if (timeout <= 120.0f) return "gt30-le120";
        return "gt120";
    }

    @Override
    public boolean isNetworkAvailable() {
        if (LOCAL_RESEARCH_DENY_HTTP) {
    // PC_BOOT_BEGIN
            // Report readiness of the independent local authority. This does
            // not enable publisher transport or grant Android INTERNET.
            if (KneekuraPcBootAuthority.available(super.getFilesDir())) {
                debugResearch("original-local-pc-authority-readiness-v1 ready");
                return true;
            }
    // PC_BOOT_END
            // Original JP15.7.1's owner-device airplane-mode trace proves
            // this false result prevents event-sale HTTP after a backup GET.
            // Keep the PHONE Wi-Fi ON; only this isolated research game uses
            // the original offline path. Never grant INTERNET to the app.
            if (LOCAL_RESEARCH_IMPORT_OWNER_ASSETS) {
                debugResearch("original-local-network-availability-v1 offline");
            }
            return false;
        }
        // For personal/practice/online research preserve exact inherited
        // original connectivity detection, not a synthetic always-false.
        return super.isNetworkAvailable();
    }

    @Override
    @SuppressWarnings({"rawtypes", "unchecked"})
    public int newHttpRequest(
            String method,
            String requestUrl,
            float timeout,
            HashMap headers,
            ByteBuffer body,
            String[] strings,
            boolean flag1,
            boolean flag2) {
        final boolean originalBackupFailureShape = isExactBackupRequest(
                method, requestUrl, timeout, headers, body, strings,
                flag1, flag2);
        boolean independentRegistration = false;
    // PC_BOOT_BEGIN
        String independentAuthOperation = "other";
        if (LOCAL_RESEARCH_DENY_HTTP) {
            try {
                independentAuthOperation = KneekuraPcBootAuthority.authOperation(
                    method, new URL(requestUrl), body, super.getFilesDir(), headers);
                independentRegistration = !"other".equals(independentAuthOperation);
            } catch (IOException | RuntimeException ignored) {
                // Invalid state or foreign identity remains denied.
            }
        }
    // PC_BOOT_END
    // PC_OBSERVER_BEGIN
        if (PC_JNI_SCENE_OBSERVER && LOCAL_RESEARCH_DENY_HTTP && originalBackupFailureShape) {
            // Fixed operation names only. Never record query values or URLs.
            // JP15.7.1 puts action first; unexpected syntax stays "other".
            String operation = "other";
            try {
                String query = new URL(requestUrl).getQuery();
                int separator = query.indexOf('&');
                String first = separator < 0 ? query : query.substring(0, separator);
                if ("action=createAccount".equals(first)) operation = "create-account";
                else if ("action=getTime".equals(first)) operation = "time";
                else if ("action=canBackup".equals(first)) operation = "can-backup";
                else if ("action=store".equals(first)) operation = "store";
            } catch (RuntimeException | IOException ignored) {
                // Observation failure does not change original failure replay.
            }
            debugResearch("original-local-pc-boot-operation-v1 " + operation);
        }
    // PC_OBSERVER_END
        if (LOCAL_RESEARCH_DENY_HTTP && !originalBackupFailureShape && !independentRegistration) {
    // PC_OBSERVER_BEGIN
            String service = "other";
            try {
                URL url = new URL(requestUrl);
                String path = url.getPath();
                if ("nyanko-auth.ponosgames.com".equals(url.getHost())) {
                    if ("/v1/users".equals(path)) service = "auth-users";
                    else if ("/v1/user".equals(path)) service = "auth-user";
                    else if ("/v1/user/password".equals(path)) service = "auth-password";
                    else if ("/v1/tokens".equals(path)) service = "auth-tokens";
                    else service = "auth-other";
                } else if ("nyanko-managed-item.ponosgames.com".equals(url.getHost())) service = "managed-items";
                else if ("nyanko-events.ponosgames.com".equals(url.getHost())) service = "events";
                else if ("nyanko-webview.ponosgames.com".equals(url.getHost())) service = "webview";
                else if ("nyanko-items.ponosgames.com".equals(url.getHost())) service = "items";
                else if ("nyanko-purchase.ponosgames.com".equals(url.getHost())) service = "purchase";
                else if ("nyanko-club.ponosgames.com".equals(url.getHost())) service = "club";
                else if ("nyanko-announcement.ponosgames.com".equals(url.getHost())) service = "announcement";
                else if ("nyanko-receipts.ponosgames.com".equals(url.getHost())) service = "receipts";
                else if ("/control.json".equals(path)) service = "web-control";
                else if (path.matches("/control/ad/battlecats[^/]{0,8}/adcontrol[^/]{0,8}\\.json")) service = "ad-control";
                else if (path.endsWith("/age/index.html") || path.endsWith("/age/gdpr.html")) service = "age-page";
                else if ("nyanko-assets.ponosgames.com".equals(url.getHost())) service = "publisher-assets";
                else if ("ponosgames.com".equals(url.getHost())) service = "publisher-web";
                else if ("www.ponosgames.com".equals(url.getHost())) service = "publisher-web";
            } catch (IOException | RuntimeException ignored) {
                // Fixed classification only; request remains denied.
            }
            debugResearch("original-local-pc-denied-service-v1 " + service);
    // PC_BOOT_BEGIN
            if ("managed-items".equals(service)) {
                debugResearch("original-local-pc-managed-shape-v1 "
                        + KneekuraPcBootAuthority.managedDiagnostic(body, super.getFilesDir(), headers));
            }
    // PC_BOOT_END
    // PC_OBSERVER_END
            // All unknown services remain strictly blocked. No invented
            // publisher payload and no original super transport fallback.
            // This remains a separate research package with zero INTERNET.
            debugResearch("original-local-denied-http-v1");
            if (LOCAL_RESEARCH_IMPORT_OWNER_ASSETS) {
                final String kind = classifyDeniedOriginalHttp(requestUrl);
                debugResearch("original-local-http-kind-v1 " + kind);
                if ("backup".equals(kind)) {
                    debugResearch("original-local-backup-shape-v1 mask="
                            + Integer.toHexString(originalBackupShapeMask(
                            method, requestUrl, timeout, headers, body,
                            strings, flag1, flag2)));
                    debugResearch("original-local-backup-timeout-class-v1 "
                            + originalBackupTimeoutClass(timeout));
                    // The existing shape mask uses URI/casefolded host;
                    // the exact backup matcher uses URL/exact hostname.
                    // A matching mask alone is not proof of safe envelope.
                    debugResearch("original-local-backup-strict-envelope-v1 "
                            + (isExactBackupRequest(method, requestUrl, 10.0f,
                            headers, body, strings, flag1, flag2)
                            ? "match" : "mismatch"));
                }
            }
            throw new IllegalStateException("original local research HTTP disabled");
        }

        if (!originalBackupFailureShape && !independentRegistration) {
            return super.newHttpRequest(
                    method,
                    requestUrl,
                    timeout,
                    headers,
                    body,
                    strings,
                    flag1,
                    flag2);
        }

        try {
            final ReflectionCache cache = reflectionCache();
            final int requestId = cache.nextRequestHandle.getInt(this);
            cache.nextRequestHandle.setInt(this, requestId + 1);

            String responseUrl = requestUrl;
            int responseStatus = 0;
            String responseHeaders = "{}";
            ByteBuffer responseBody = null;
            boolean responseError = true;
    // PC_BOOT_BEGIN
            final String localOperation = independentRegistration ? independentAuthOperation
                : KneekuraPcBootAuthority.operation(new URL(requestUrl).getQuery());
            if (!"other".equals(localOperation)) {
                // Actual independent operation first, compatibility delivery
                // second. URI and header explicitly identify local origin.
                // No official account, socket, or remote success claim.
                KneekuraPcBootAuthority.SignedResponse signedResponse = independentRegistration
                    ? ("register".equals(localOperation)
                        ? KneekuraPcBootAuthority.signedRegistration(body, super.getFilesDir())
                        : ("refresh-password".equals(localOperation)
                            ? KneekuraPcBootAuthority.signedPasswordRefresh(body, super.getFilesDir())
                            : ("tokens".equals(localOperation)
                            ? KneekuraPcBootAuthority.signedTokens(body, super.getFilesDir())
                            : KneekuraPcBootAuthority.signedManagedBootstrap(body, super.getFilesDir(), headers)))) : null;
                String payload = independentRegistration ? signedResponse.body
                    : KneekuraPcBootAuthority.payload(localOperation, super.getFilesDir());
                byte[] bytes = payload.getBytes(java.nio.charset.StandardCharsets.UTF_8);
                responseBody = ByteBuffer.allocateDirect(bytes.length);
                responseBody.put(bytes);
                responseBody.flip();
                responseUrl = "file:///kneekura-local/boot/" + localOperation;
                responseStatus = 200;
                responseError = false;
                // JNI newResponse reads each header's JSON string getter,
                // not a list. An array decodes to an empty signature buffer.
                responseHeaders = "{\"X-Kneekura-Authority\":\"local\"}";
                if (signedResponse != null) responseHeaders = "{\"X-Kneekura-Authority\":\"local\","
                    + "\"Nyanko-Signature\":\"" + signedResponse.signature + "\"}";
                debugResearch("original-local-pc-boot-authority-v1 " + localOperation);
            }
    // PC_BOOT_END
            final String callbackUrl = responseUrl;
            final int callbackStatus = responseStatus;
            final String callbackHeaders = responseHeaders;
            final ByteBuffer callbackBody = responseBody;
            final boolean callbackError = responseError;
            final URL parsedUrl = new URL(callbackUrl);
            final Object request = cache.requestConstructor.newInstance(
                    requestId,
                    method,
                    parsedUrl,
                    timeout,
                    headers,
                    body,
                    strings);

            final Map requestMap = (Map) cache.requestHandles.get(this);
            requestMap.put(Integer.valueOf(requestId), request);

            final GLSurfaceView view = (GLSurfaceView) cache.glView.get(this);
            view.queueEvent(new Runnable() {
                @Override
                public void run() {
                    jp.co.ponos.battlecats.MyActivity.newResponse(
                            requestId,
                            callbackStatus,
                            callbackUrl,
                            callbackHeaders,
                            callbackBody,
                            callbackError);
    // PC_BOOT_BEGIN
                    if (!callbackError) {
                        debugResearch("original-local-pc-boot-authority-v1 returned");
                        return;
                    }
    // PC_BOOT_END
                    if (LOCAL_RESEARCH_DENY_HTTP) {
                        // This fires after the real GL-thread callback RETURNS,
                        // unlike the legacy misnamed "completed" marker which
                        // merely meant queued. This still does not prove native
                        // scene advancement or any real publisher response.
                        debugResearch("original-local-backup-callback-v1 returned");
                        if (Float.compare(timeout, 10.0f) != 0) {
                            debugResearch("original-local-backup-timeout-variant-v1 returned");
                        }
                    }
                }
            });
            if (LOCAL_RESEARCH_DENY_HTTP) {
    // PC_BOOT_BEGIN
                if (!callbackError) {
                    debugResearch("original-local-pc-boot-authority-v1 enqueued");
                    return requestId;
                }
    // PC_BOOT_END
                // Scheduling is NOT evidence the callback actually ran.
                debugResearch("original-local-backup-failure-fallback-v1 enqueued");
                if (Float.compare(timeout, 10.0f) != 0) {
                    debugResearch("original-local-backup-timeout-variant-v1 enqueued");
                }
            } else {
                debugResearch("backup-local-replay requestId=" + requestId);
            }
            return requestId;
        } catch (Throwable ignored) {
            if (LOCAL_RESEARCH_DENY_HTTP) {
    // PC_BOOT_BEGIN
                String failure = "other";
                String detail = ignored.getMessage();
                if ("LOCAL_AUTH_KEY_UNAVAILABLE".equals(detail)) failure = "key-unavailable";
                else if ("LOCAL_AUTH_KEY_FINGERPRINT_MISMATCH".equals(detail)) failure = "key-fingerprint";
                else if ("LOCAL_AUTH_SIGNATURE_UNAVAILABLE".equals(detail)) failure = "signature";
                else if ("LOCAL_AUTH_REQUEST_INVALID".equals(detail)) failure = "request";
                else if ("LOCAL_AUTH_JSON_INVALID".equals(detail)) failure = "json";
                else if (ignored instanceof IOException) failure = "local-io";
                debugResearch("original-local-pc-boot-authority-error-v1 " + failure);
    // PC_BOOT_END
                // Never invoke original HTTP if local reflection/callback
                // invariants drift. No request payload, URL or exception log.
                debugResearch("original-local-backup-failure-fallback-v1 unavailable");
                throw new IllegalStateException("original local backup fallback unavailable");
            }
            debugResearch("backup-local-replay fallback-to-original");
            // Fail closed: unexpected research replay drift returns to the
            // exact original JP 15.7.1 implementation only outside local mode.
            return super.newHttpRequest(
                    method,
                    requestUrl,
                    timeout,
                    headers,
                    body,
                    strings,
                    flag1,
                    flag2);
        }
    }
}
